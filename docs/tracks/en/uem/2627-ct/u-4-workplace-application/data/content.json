  "slides": [
    {
      "slide_role": "unit_cover",
      "background_kind": "profield",
      "media_slot_id": "U4.still.profield-1",
      "heading": "U4 · Creativity techniques at work",
      "sentence": "Techniques meet briefs, deadlines, teams, and credit — or they stay classroom games.",
      "quote": "A vote is not a visit. Preference is not proof.",
      "quote_origin": "tao_invented",
      "citation": {
        "label": "(Tao of Creativity)",
        "href": "/creativity-techniques-uem/lessons/en/creativity-techniques/u-4-workplace-application/#references"
      }
    },
    {
      "slide_role": "analysis_opener",
      "background_kind": "geometrical",
      "heading": "Analysis opens the class",
      "sentence": "From session 3: two students defend a D1 piece for 15 minutes. Ask how the piece would survive a workplace brief."
    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U4.still.profield-3",
      "heading": "1 · Conditions beat slogans",
      "sentence": "Time, safety, and permission are design decisions. Overload pushes thinking toward convention.",
      "citation": {
        "label": "(Fisher 2012, 27)",
        "href": "/creativity-techniques-uem/lessons/en/creativity-techniques/u-4-workplace-application/#ref-fisher-2012"
      }
    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U4.still.profield-4",
      "heading": "2 · Watch passion rhetoric",
      "sentence": "Enthusiasm is not consent to unlimited or uncredited work. Keep a contribution log."
    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U4.still.profield-5",
      "heading": "3 · Design the diverge window",
      "sentence": "Protect generation before judging. The deadline stays; the window is scheduled.",
      "citation": {
        "label": "(Michalko 2010, 440)",
        "href": "/creativity-techniques-uem/lessons/en/creativity-techniques/u-4-workplace-application/#ref-michalko-2010"
      }
    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U4.still.profield-6",
      "heading": "4 · Techniques meet stakeholders",
      "sentence": "Dots on the wall show the team’s favourite ideas. They do not show that a real visitor can use the design.",
      "citation": {
        "label": "(Michalko 2010, 402)",
        "href": "/creativity-techniques-uem/lessons/en/creativity-techniques/u-4-workplace-application/#ref-michalko-2010"
      }
    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U4.still.profield-7",
      "heading": "5 · Pitch is convergent craft",
      "sentence": "Present criteria, limits, and the next test. Keep one unresolved concern on the card."
    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "heading": "6 · Ethics inside the method",
      "sentence": "Name harm, credit, and feasibility before a team calls an idea ready.",
      "media_slot_id": "U4.still.profield-8"
    },
    {
      "slide_role": "lab_opener",
      "background_kind": "geometrical",
      "heading": "Lab · Portfolio",
      "sentence": "Two exercises come next. Everything you make in Lab goes into your portfolio index.",
      "portfolio_bound": true,
      "portfolio_trace": "Save both traces in the portfolio index."
    },
    {
      "slide_role": "lab_exercise",
      "background_kind": "diagram",
      "heading": "Exercise 1 · Ask a Crab — picture diverge",
      "sentence": "Follow Michalko’s BLUEPRINT steps 1–4 under the Atrium brief. Defer step 5 evaluate (Michalko 2010, 439–440).",
      "portfolio_bound": true,
      "portfolio_trace": "Save the brief, pictures used, idea list, and the note that evaluation was deferred."
    },
    {
      "slide_role": "lab_exercise",
      "background_kind": "diagram",
      "heading": "Exercise 2 · Wall of Ideas — cluster and prefer",
      "sentence": "Run Wall of ideas for clustering and dots, then a decision card with one unresolved concern (Michalko 2010, 402).",
      "portfolio_bound": true,
      "portfolio_trace": "Save wall photo, tally, decision card, contribution log, and what the tally does not prove."
    },
    {
      "slide_role": "workshop_work",
      "background_kind": "profield",
      "heading": "Workshop · Pitch the decision",
      "sentence": "Show the decision card: what you chose, why it fits the brief, what you will test next, and one concern still open.",
      "media_slot_id": "U4.still.profield-2"
    },
    {
      "slide_role": "outro",
      "background_kind": "geometrical",
      "heading": "Carry forward",
      "sentence": "A class vote is not a visitor test. Name the gap you will investigate next."
    }
  ],
