      "slide_role": "lab_exercise",
      "background_kind": "profield",
      "heading": "Exercise 1 · Guided concentration",
      "sentence": "Follow the guided meditation exactly as indicated. Attend to breath, bodily sensation, and the surrounding field without evaluating or producing ideas yet.",
      "portfolio_bound": true,
      "portfolio_trace": "Record the instructions or sequence followed, the duration indicated in class, and two brief observations about changes in attention.",
      "quote": "Concentration is not the absence of ideas; it is a deliberate change in the conditions under which ideas may appear.",
