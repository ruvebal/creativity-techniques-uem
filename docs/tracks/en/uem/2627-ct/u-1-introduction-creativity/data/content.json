      }
    },
    {
      "slide_role": "analysis_opener",
      "background_kind": "geometrical",
      "heading": "Analysis opens the class",
      "sentence": "Sessions 1–2: the professor shows how to analyse. From session 3: two students start with a 15-minute defence each.",
      "quote": "The professor models first; from session three, you defend what the piece is made of.",
      "quote_origin": "tao_invented",
      "semantic_tags": {
        "themes": [
