    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U1.still.profield-6",
      "heading": "6 · “Design thinking” is debated",
      "sentence": "Use useful tools — and ask when buzzwords hide weak craft or skip the hard part.",
      "quote": "When the buzzword arrives, ask what craft it is hiding — slogans are often empty handles.",
