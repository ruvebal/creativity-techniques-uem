    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U1.still.profield-12",
      "heading": "5 · Techniques are tools, not scripts",
      "sentence": "A method helps you talk with the situation. It does not replace your judgement or the brief.",
      "quote": "A technique is a lever, not a verdict — it moves the work; it does not replace your judgement.",
      "quote_origin": "tao_invented",
      "semantic_tags": {
