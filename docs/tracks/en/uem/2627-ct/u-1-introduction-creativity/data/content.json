      }
    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U1.still.profield-11",
      "heading": "4 · Name the problem first",
      "sentence": "Before you grab a creativity technique, say what is unclear in the brief — name the problem, then pick the tool.",
      "quote": "Before you pick a method, write the question the brief still refuses to answer.",
      "quote_origin": "tao_invented",
      "semantic_tags": {
