      }
    },
    {
      "slide_role": "analysis_model",
      "background_kind": "profield",
      "media_slot_id": "U1.still.profield-2",
      "heading": "How to analyse (model)",
      "sentence": "Say what the piece is made of first: language, medium, support. Then ask where meaning travels when someone else sees it.",
      "quote": "Name language, medium, and support before you praise the idea — otherwise you are judging a shadow.",
      "quote_origin": "tao_invented",
      "semantic_tags": {
        "themes": [
          "analysis",
          "materiality"
