      "media_slot_id": "U1.still.profield-1",
      "heading": "U1 · Introduction to creativity",
      "sentence": "Creativity is work you can pace: open many options, then choose what fits the brief — not a talent myth.",
      "quote": "Open many doors on Monday; close most of them on Tuesday — that rhythm is the craft, not the mood.",
      "quote_origin": "tao_invented",
      "semantic_tags": {
        "themes": [
          "brief-craft",
          "diverge-converge"
        ],
