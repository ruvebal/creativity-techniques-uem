    },
    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "media_slot_id": "U1.still.profield-5",
      "heading": "3 · Tests are not the whole story",
      "sentence": "Scoring well on “uses of a brick” does not prove you are strong in another field — tests need context.",
      "quote": "After all, the ability of divergent thinking with a paper clip may tell us little about an individual's talent in music.",
      "citation": {
        "label": "(Chen 2012, 41)",
        "href": "/creativity-techniques-uem/lessons/en/creativity-techniques/u-1-introduction-creativity/#ref-chen-2012"
      },
